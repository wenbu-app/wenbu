{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wenbu",
  "account_id": "48d9ccaf5ee7914c803b5d0656462848",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash",
    "run_worker_first": ["/*", "!/_astro/*", "!/images/*", "!/favicon.svg", "!/og.png"],
  },
  "vars": {
    "SITE_URL": "https://wenbu.app",
    "ACCOUNTS_ENABLED": "true",
    "ACCOUNTS_MAINTENANCE": "false",
    "AUTH_EMAIL_FROM": "login@wenbu.app",
    "AUTH_EMAIL_DAILY_LIMIT": "1000",
    "AI_NETWORK_DAILY_LIMIT": "50",
    "AGENT_NETWORK_DAILY_LIMIT": "120",
    "DEEPSEEK_MODEL": "deepseek-v4-flash",
    "AI_DAILY_LIMIT": "1000",
    "AI_PER_USER_DAILY_LIMIT": "5",
    "AGENT_PER_USER_DAILY_LIMIT": "12",
    "AGENT_GLOBAL_DAILY_LIMIT": "600",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "QUOTA",
        "class_name": "UsageGate",
      },
      { "name": "PRIVACY_LEDGER", "class_name": "DeletionLedger" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UsageGate"],
    },
    { "tag": "v2", "new_sqlite_classes": ["DeletionLedger"] },
  ],
  "ratelimits": [
    { "name": "FEEDBACK_LIMITER", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } },
    { "name": "ADMIN_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    { "name": "ANALYTICS_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
  ],
  "send_email": [{ "name": "AUTH_EMAIL", "allowed_sender_addresses": ["login@wenbu.app"] }],
  "d1_databases": [
    {
      "binding": "USERDATA",
      "database_name": "wenbu-userdata",
      "database_id": "fa1a0a4f-afda-4aa4-9a27-a432843b92b1",
      "migrations_dir": "migrations-userdata",
    },
    {
      "binding": "ANALYTICS",
      "database_name": "wenbu-analytics",
      "database_id": "ad0bb9f2-43d5-47f0-a404-06f071b85935",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "ANALYTICS_ARCHIVE", "bucket_name": "wenbu-analytics-archive" }],
  "triggers": { "crons": ["15 * * * *", "*/15 * * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
    "traces": { "enabled": false },
  },
  "preview_urls": false,
  "routes": [
    { "pattern": "wenbu.app", "custom_domain": true },
    { "pattern": "www.wenbu.app", "custom_domain": true },
    {
      "pattern": "wenbu.genedai.me",
      "custom_domain": true,
    },
  ],
}
