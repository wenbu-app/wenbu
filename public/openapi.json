{
  "openapi": "3.1.0",
  "info": {
    "title": "Wenbu · 问卜",
    "version": "1.1.0",
    "description": "Free, transparent cultural calculation tools. No predictive validity claims.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "servers": [
    {
      "url": "https://wenbu.app"
    }
  ],
  "paths": {
    "/api/v1/daily": {
      "post": {
        "operationId": "get_daily_card",
        "summary": "Stable upright daily card and original reflective practice; no model or birth data",
        "description": "The server chooses today in the requested IANA timezone. Native clients may supply a stable random UUID seed, never personal data; clients without a seed share a public card. First-party guest/account identities take precedence. Status requests do not reveal a card. No personal forecast or same-day redraw. Private account saves use the first-party account protocol.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action",
                  "timezone"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "status",
                      "reveal"
                    ]
                  },
                  "timezone": {
                    "type": "string",
                    "maxLength": 80,
                    "example": "Asia/Shanghai"
                  },
                  "locale": {
                    "enum": [
                      "zh",
                      "en"
                    ]
                  },
                  "seed": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "previous": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "result",
                      "receipt"
                    ],
                    "properties": {
                      "result": {
                        "type": "object"
                      },
                      "receipt": {
                        "type": "string",
                        "maxLength": 3000
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Private/no-store server clock and, for reveal, an upright card. First-party callers may receive an X-Wenbu-Receipt header.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "clock"
                  ],
                  "properties": {
                    "clock": {
                      "type": "object",
                      "required": [
                        "date",
                        "timezone",
                        "serverNow",
                        "nextAt"
                      ],
                      "properties": {
                        "date": {
                          "type": "string",
                          "format": "date"
                        },
                        "timezone": {
                          "type": "string"
                        },
                        "serverNow": {
                          "type": "integer",
                          "description": "Server epoch milliseconds"
                        },
                        "nextAt": {
                          "type": "integer",
                          "description": "Next local midnight epoch milliseconds; DST-aware"
                        }
                      }
                    },
                    "result": {
                      "type": "object",
                      "description": "Tarot result with one upright card and daily version/date/timezone. Not a prediction."
                    },
                    "practice": {
                      "type": "object",
                      "required": [
                        "action",
                        "question"
                      ],
                      "properties": {
                        "action": {
                          "type": "string"
                        },
                        "question": {
                          "type": "string"
                        }
                      },
                      "description": "Original editorial daily practice in the requested locale; no generated prediction."
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid IANA timezone, seed, fields or operation"
          },
          "429": {
            "description": "Request rate limit"
          }
        }
      }
    },
    "/api/v1/bazi": {
      "post": {
        "operationId": "calculate_bazi",
        "summary": "Calculate or draw bazi symbols",
        "description": "No authentication. Cultural reflection, not established prediction. JSON body capped at 8192 bytes. Rate limits apply.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "description": "Gregorian date, 1901–2099"
                  },
                  "time": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "timezone": {
                    "type": "string",
                    "default": "Asia/Shanghai",
                    "maxLength": 80
                  },
                  "dayBoundary": {
                    "type": "string",
                    "enum": [
                      "midnight",
                      "zi"
                    ],
                    "default": "midnight"
                  },
                  "solarTime": {
                    "type": "boolean",
                    "default": false
                  },
                  "longitude": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "locale": {
                    "type": "string",
                    "enum": [
                      "zh",
                      "en"
                    ],
                    "default": "zh"
                  }
                },
                "required": [
                  "date"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Structured result including method and conventions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "kind",
                    "version",
                    "method"
                  ],
                  "properties": {
                    "kind": {
                      "const": "bazi"
                    },
                    "version": {
                      "type": "string"
                    },
                    "method": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON"
          },
          "403": {
            "description": "Browser origin rejected"
          },
          "413": {
            "description": "Request too large"
          },
          "415": {
            "description": "JSON content type required"
          },
          "422": {
            "description": "Invalid input or ambiguous date/time"
          },
          "429": {
            "description": "Request limit reached"
          }
        }
      }
    },
