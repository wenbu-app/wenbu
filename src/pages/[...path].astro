---
import Layout from '../layouts/Layout.astro';
import DomainMove from '../components/DomainMove.astro';
import '../styles/library.css';
import '../styles/handbook.css';
import GuideDepth from '../components/GuideDepth.astro';
import GuideFigure from '../components/GuideFigure.astro';
import { guideDepth, handbookUpdated } from '../data/guide-depth';
import { guideOutline, guideMinutes, knowledgeDocument, knowledgeLinks } from '../lib/knowledge';
import KnowledgeLibrary from '../components/KnowledgeLibrary.astro';
import ArticleCompanion from '../components/ArticleCompanion.astro';
import { newGuideSlugs, topicForGuide } from '../data/learning-paths';
import AnalyticsDashboard from '../components/AnalyticsDashboard';
import TarotGallery from '../components/TarotGallery';
import AnalyticsPreference from '../components/AnalyticsPreference';
import Home from '../components/Home.astro';
import ToolDesk from '../components/ToolDesk';
import Journal from '../components/Journal';
import AgentWorkspace from '../components/AgentWorkspace';
import ArticleCard from '../components/ArticleCard.astro';
import Agents from '../components/Agents.astro';
import { articles } from '../data/articles';
import { pages } from '../data/pages';
import { comparisons } from '../data/comparisons';
import { sources } from '../data/sources';
import { choose, href, toolInfo } from '../lib/i18n';
import type { Locale, ToolKind } from '../lib/schema';
export function getStaticPaths() {
  const paths = [
    '',
    'bazi',
    'iching',
    'tarot',
    'tarot/deck',
    'ziwei',
    'journal',
    'move',
    'learn',
    'blog',
    'agents',
    'agent',
    'sources',
    'insights',
    ...Object.keys(pages),
    ...articles.map((a) => `${a.category}/${a.slug}`),
    ...comparisons.map((c) => `compare/${c.slug}`),
  ];
  return (['zh', 'en'] as const).flatMap((locale) =>
    paths.map((path) => ({
      params: { path: (locale === 'en' ? `en/${path}` : path).replace(/\/$/, '') || undefined },
      props: { locale, path },
    })),
  );
}
const { locale, path } = Astro.props as { locale: Locale; path: string };
const t = (zh: string, en: string) => choose(locale, zh, en);
const article = articles.find((a) => `${a.category}/${a.slug}` === path);
const comparison = comparisons.find((c) => `compare/${c.slug}` === path);
const content = pages[path]?.[locale];
const kind = path in toolInfo ? (path as ToolKind) : null;
const tool = kind ? toolInfo[kind] : null;
const titles: Record<string, [string, string]> = {
  '': ['免费八字、易经、塔罗与紫微工具', 'Free BaZi, I Ching, tarot & Zi Wei tools'],
  bazi: ['免费八字排盘，读懂你的五行底色', 'Free BaZi calculator & Four Pillars chart'],
  iching: ['免费易经占卜，从一卦看见变化', 'Free I Ching reading & hexagram oracle'],
  'tarot/deck': ['78 张塔罗牌图鉴 · 问卜原创插画与牌义', '78 tarot cards · the illustrated Wenbu deck'],
  tarot: ['免费塔罗占卜，遇见新的视角', 'Free tarot reading · one & three cards'],
  ziwei: ['免费紫微斗数排盘，十二宫可视化', 'Free Zi Wei Dou Shu chart calculator'],
  journal: ['我的手记', 'Your reading journal'],
  move: ['迁移本地记录', 'Move your local history'],
  learn: ['知识手册', 'The Wenbu library'],
  blog: ['问卜札记', 'Notes from Wenbu'],
  agents: ['与你的 Agent 一起探索', 'Wenbu for agents · MCP, CLI & Skills'],
  agent: ['命理 Agent · 对话、排盘与有依据的研习', 'Wenbu Agent · chat, charts & sourced research'],
  insights: ['访问与使用 · 管理后台', 'Product analytics · administration'],
  sources: ['参考资料与研究来源', 'Sources & further reading'],
};
const descriptions: Record<string, [string, string]> = {
  move: [
    '把旧站保存在浏览器里的手记和 Agent 对话复制到 wenbu.app。原记录保留，数据不上传到服务器。',
    'Copy the journal and Agent conversations stored in your browser to wenbu.app. Original records stay intact and no history is uploaded to a server.',
  ],
  '': [
    '免费探索八字命盘、易经问卦、78 张塔罗和紫微星盘。无需注册，计算依据透明，可选 AI 解读、本地手记和 MCP Agent 接口。',
    'Explore free BaZi charts, I Ching casts, a full 78-card tarot deck and Zi Wei. No account needed. Transparent methods, optional AI and a local journal.',
  ],
  'tarot/deck': [
    '浏览完整 78 张塔罗牌：22 张大阿卡纳与四组小阿卡纳。原创 AI 插画、正逆位关键词、放大查看。免费探索传统象征与自己的问题。',
    'Browse all 78 tarot cards: original AI illustrations, upright and reversed themes, major arcana and four suits. Open each artwork and explore for free.',
  ],
  journal: [
    '留住当时的问题，也留住后来的理解。先免费试用；登录后可保存到云端，在不同设备间回看和导出。',
    'Keep the question you had and the understanding that followed. Try freely, then sign in to keep entries in the cloud and revisit them across devices.',
  ],
  learn: [
    '第一次怎么选、怎么问、怎么看结果？从上手步骤到术语与计算依据，按你遇到的问题慢慢读。',
    'New to BaZi, tarot, the I Ching or Zi Wei? Start with a practical guide, learn the terms and check the sources. Read in English or Chinese.',
  ],
  blog: [
    '记录我们如何提问、如何理解，又如何回到真实生活。阅读关于手记习惯、计算依据和日常自我觉察的原创文章。',
    'Notes on asking, interpreting, and returning to everyday life.',
  ],
  agents: [
    '开放的计算工具，由你选择的上下文。把命盘与问题带给你熟悉的 Agent。',
    'Open calculation tools and context you choose. Bring the chart and question to an agent you already know.',
  ],
  agent: [
    '与 AI 驱动的命理 Agent 对话，调用八字、易经、塔罗与紫微工具，查阅资料、查看命盘、整理带出处的研究札记，并持续追问。',
    'Explore with a AI-powered agent: calculate BaZi and Zi Wei, cast I Ching, draw tarot, read sources and create research notes with optional email sign-in to save your conversations across browsers.',
  ],
  sources: [
    '把经典、计算依据、研究和产品自述分开，知道每一种说法从哪里来。',
    'Classical texts, calculation references, research and product statements, with their different roles kept clear.',
  ],
};
const title =
  article?.[locale].title ||
  comparison?.[locale].title ||
  content?.title ||
  t(...(titles[path] || titles['']));
const description =
  article?.[locale].description ||
  comparison?.[locale].description ||
  content?.description ||
  (tool
    ? t(
        tool.descriptionZh +
          '免费使用，无需注册，计算规则与来源公开，支持可选 AI 解读、可选云端记录和 Agent 导出。',
        tool.descriptionEn +
          ' Free, without an account. View calculation conventions, save locally and export for your agent.',
      )
    : t(...(descriptions[path] || descriptions[''])));
const displayHeading = kind ? t(tool!.zh, tool!.en) : title;
const articlePublished =
  article?.published ??
  (article && (newGuideSlugs as readonly string[]).includes(article.slug) ? '2026-09-29' : '2026-09-28');
const depth = article ? guideDepth[article.slug]?.[locale] : undefined;
const outline = article ? guideOutline(article, locale) : [];
const articleUpdated = article?.updated ?? (depth ? handbookUpdated : '2026-09-29');
const articleSources = article ? knowledgeDocument(article, locale).sources : [];
const exports = article && depth ? knowledgeLinks(article.slug, locale) : undefined;
const articleTopic = article ? topicForGuide(article.slug) : undefined;
const nextArticles = article
  ? articleTopic
    ? articleTopic.slugs
        .map((slug) => articles.find((a) => a.slug === slug))
        .filter((a) => a && a.slug !== article.slug)
        .slice(0, 2)
    : articles.filter(
        (a) => a.category === 'learn' && (a.slug === 'review-a-reading' || a.slug === 'first-reading'),
      )
  : [];
const ctaLabels: Record<string, [string, string]> = {
  bazi: ['排一张八字命盘', 'Calculate a BaZi chart'],
  iching: ['试一次易经起卦', 'Try an I Ching cast'],
  tarot: ['从一张塔罗牌开始', 'Try a tarot reading'],
  ziwei: ['查看紫微命盘', 'Calculate a Zi Wei chart'],
  agent: ['打开命理 Agent', 'Open Wenbu Agent'],
  journal: ['打开我的手记', 'Open your journal'],
};
---

<Layout
  title={title}
  description={description}
  locale={locale}
  path={path}
  noindex={path === 'journal' || path === 'insights' || path === 'move'}
  article={Boolean(article)}
  published={articlePublished}
  modified={article ? articleUpdated : undefined}
  knowledge={exports}
  citations={articleSources.map((s) => s.url)}
  collection={
    path === 'learn'
      ? articles
          .filter((a) => a.category === 'learn')
          .map((a) => ({ title: a[locale].title, path: `learn/${a.slug}` }))
      : undefined
  }
  workspace={path === 'agent'}
>
  {path === '' ? (
    <Home locale={locale} />
  ) : path === 'move' ? (
    <DomainMove locale={locale} />
  ) : path === 'tarot/deck' ? (
    <TarotGallery locale={locale} client:visible />
  ) : path === 'insights' ? (
    <AnalyticsDashboard locale={locale} client:load />
  ) : path === 'agent' ? (
    <>
      <AgentWorkspace locale={locale} client:load />
      <noscript>
        <div class="shell">
          <p>
            {t(
              '命理 Agent 的对话需要 JavaScript。你仍可阅读手册和使用公开 API。',
              'The Agent workspace needs JavaScript. The library and public API remain available.',
            )}
          </p>
          <a href={href(locale, 'agents')}>API / CLI / MCP</a>
        </div>
      </noscript>
    </>
  ) : (
    <div class="shell">
      <header class:list={['page-intro', { 'library-intro': path === 'learn' }]}>
        <div class="breadcrumbs">
          <a href={href(locale)}>{t('首页', 'Home')}</a>
          <span>/</span>
          {article ? (
            <>
              <a href={href(locale, article.category)}>
                {t(
                  article.category === 'blog' ? '札记' : '手册',
                  article.category === 'blog' ? 'Notes' : 'Library',
                )}
              </a>
              <span>/</span>
            </>
          ) : null}
          <span>{kind ? t(tool!.zh, tool!.en) : article ? t('阅读', 'Reading') : t('探索', 'Explore')}</span>
        </div>
        <span class="eyebrow">
          {(tool ? t(tool.eyebrowZh, tool.eyebrow) : null) ||
            (article
              ? article.category === 'blog'
                ? t('问卜札记', 'NOTES FROM WENBU')
                : t('知识手册', 'THE WENBU LIBRARY')
              : comparison
                ? t('产品比较', 'PRODUCT COMPARISON')
                : path === 'learn'
                  ? t('一起从基础读起', 'A GUIDE TO GETTING STARTED')
                  : path === 'journal'
                    ? t('让探索有迹可循', 'YOUR READING JOURNAL')
                    : t('关于问卜', 'ABOUT WENBU'))}
        </span>
        <h1>{displayHeading}</h1>
        <p>{tool ? t(tool.descriptionZh, tool.descriptionEn) : description}</p>
        {article && (
          <div class="article-meta">
            <span>Wenbu · {t('AI 辅助编辑', 'AI-assisted editorial')}</span>
            <time datetime={articleUpdated}>
              {t('更新于 ', 'Updated ')}
              {articleUpdated}
            </time>
            <span>
              {guideMinutes(article, locale)} {t('分钟阅读', 'min read')}
            </span>
          </div>
        )}
      </header>
      {kind && (
        <>
          <ToolDesk kind={kind} locale={locale} client:load />
          <noscript>
            <p>
              {t(
                '交互工具需要 JavaScript。你仍然可以阅读完整说明，或使用公开 REST API 与 CLI。',
                'Interactive tools require JavaScript. You can still read the guides or use the public REST API and CLI.',
              )}
            </p>
            <a href={href(locale, 'agents')}>API / CLI</a>
          </noscript>
          <div class="tool-support">
            <div>
              <h2>{t('先看见，再理解。', 'See the structure. Then explore.')}</h2>
              <p>
                {t(
                  '工具会先给出原始结果，你可以查看计算方法，再决定是否请求解读。解读是一个思考的起点，而不是必须照做的结论。',
                  'Your original result comes first. Inspect the method before deciding whether to request a reading. An interpretation is a starting point for thought, not an instruction to obey.',
                )}
              </p>
              <a class="text-link" href={href(locale, 'methodology')}>
                {t('了解计算与依据', 'Explore our methods')} ↗
              </a>
              <div class="related-reading">
                <h3>{t('从这里读起', 'Start reading')}</h3>
                {articles
                  .filter((a) => a.tool === kind)
                  .slice(0, 3)
                  .map((a) => (
                    <a href={href(locale, `${a.category}/${a.slug}`)}>{a[locale].title} ↗</a>
                  ))}
              </div>
            </div>
            <div class="faq">
              <h2>{t('你可能想知道', 'A few good questions')}</h2>
              <details>
                <summary>{t('真的免费吗？', 'Is it really free?')}</summary>
                <p>
                  {t(
                    '排盘、抽牌、起卦和手记免费。访客试用或账号每日可用 5 次 AI 解读，登录归并当天用量；另受网络防滥用与全站额度限制，上海时间零点重置。',
                    'Charts, draws, casts and the journal are free. Guests and accounts receive five AI readings per Shanghai day. Signing in carries over trial usage. Network abuse controls and a site budget also apply.',
                  )}
                </p>
              </details>
              <details>
                <summary>{t('资料会被公开吗？', 'Will my information be public?')}</summary>
                <p>
                  {t(
                    '不会自动公开。排盘输入通过 POST 发送；试用手记暂存在当前浏览器，登录并开启云端记录后可同步。AI 解读需你主动确认将当前信息发送给 AI。',
                    'Nothing is published automatically. Guest records stay in this browser; optional email sign-in enables cloud history. Requesting an AI reading sends the current information to AI.',
                  )}
                </p>
              </details>
              <details>
                <summary>
                  {t('可以把结果交给自己的 Agent 吗？', 'Can I use the result with my agent?')}
                </summary>
                <p>
                  {t(
                    '可以。结果下方可预览并导出 JSON 上下文，也可以通过 MCP、CLI 或 REST 直接计算。',
                    'Yes. Preview and download a JSON context export below the result, or calculate through MCP, CLI or REST.',
                  )}
                </p>
              </details>
              <details>
                <summary>{t('结果能预测我的未来吗？', 'Does it predict my future?')}</summary>
                <p>
                  {t(
                    '它提供传统符号与反思视角，不保证未来事件。重大决定仍需现实信息、直接沟通与适当的专业意见。',
                    'It offers traditional symbols and a perspective for reflection, not a guarantee of future events. Major decisions still need evidence, communication and appropriate professional advice.',
                  )}
                </p>
              </details>
            </div>
          </div>
        </>
      )}
      {path === 'journal' && <Journal locale={locale} client:load />}
      {path === 'learn' && <KnowledgeLibrary locale={locale} />}
      {path === 'blog' && (
        <>
          <div class="article-grid library-grid">
            {articles
              .filter((a) => a.category === path)
              .map((a) => (
                <ArticleCard article={a} locale={locale} />
              ))}
          </div>
          <div class="related-reading" style="margin-bottom:60px">
            <h3>{t('选择工具之前，也可以看看', 'Before choosing a tool')}</h3>
            {comparisons.map((c) => (
              <a href={href(locale, `compare/${c.slug}`)}>{c[locale].title} ↗</a>
            ))}
            <a href={href(locale, 'learn')}>{t('翻开知识手册', 'Browse the library')} ↗</a>
          </div>
        </>
      )}
      {article && (
        <div class="prose-grid">
          <article class="prose">
            <details class="article-mobile-toc">
              <summary>{t('这一篇讲什么', 'On this page')}</summary>
              <nav aria-label={t('文章目录', 'Article contents')}>
                {outline.map((s) => (
                  <a href={`#${s.id}`}>{s.title}</a>
                ))}
              </nav>
            </details>
            {depth ? (
              <>
                <GuideDepth copy={depth} locale={locale} part="answer" />
                <GuideFigure article={article} locale={locale} />
              </>
            ) : (
              <ArticleCompanion slug={article.slug} locale={locale} />
            )}
            {article[locale].sections.map((section, i) => (
              <>
                <section id={`section-${i}`}>
                  <h2>{section.heading}</h2>
                  {section.paragraphs.map((p) => (
                    <p>{p}</p>
                  ))}
                  {section.bullets && (
                    <ul>
                      {section.bullets.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                  )}
                </section>
                {depth && i === 1 && <GuideDepth copy={depth} locale={locale} part="table" />}
              </>
            ))}
            {depth && <GuideDepth copy={depth} locale={locale} part="practice" />}
            <div class="source-list" id="sources">
              <h2>{t('来源与适用范围', 'Sources and their scope')}</h2>
              {articleSources.map((s) => (
                <div class="annotated-source">
                  <a href={s.url} target="_blank" rel="noreferrer">
                    {s.title} ↗
                  </a>
                  <p>{s.scope}</p>
                </div>
              ))}
              <p>
                {t(
                  '文中传统解释不等于经过验证的现实预测；来源角色详见研究说明。',
                  'Traditional interpretations are not established predictions. See the source notes for context.',
                )}
              </p>
            </div>
            {exports && (
              <section
                class="knowledge-downloads"
                aria-label={t('把文章带给你的 Agent', 'Read with your agent')}
              >
                <h2>{t('把这篇文章带给你的 Agent', 'Read this guide with your agent')}</h2>
                <p>
                  {t(
                    '完整正文、图示说明与来源，提供可直接读取的开放格式。仅包含公开知识内容。',
                    'Get the complete text, diagram descriptions and sources in an open format. These files contain public knowledge only.',
                  )}
                </p>
                <div>
                  <a href={exports.markdown} data-track="guide-markdown">
                    Markdown ↗
                  </a>
                  <a href={exports.json} data-track="guide-json">
                    JSON ↗
                  </a>
                  <a href={href(locale, 'agents')}>{t('MCP 与 CLI 用法', 'MCP & CLI instructions')} ↗</a>
                </div>
              </section>
            )}
            <div class="article-try">
              <p>{t('读到这里，可以试一试。', 'Ready to put this into practice?')}</p>
              <a class="button primary" href={href(locale, article.tool)} data-track="article-tool">
                {t(...(ctaLabels[article.tool] || ctaLabels.agent))} ↗
              </a>
            </div>
            <nav class="article-next" aria-label={t('继续阅读', 'Further reading')}>
              <h2>{t('接下来可以读', 'Read next')}</h2>
              {nextArticles.map(
                (a) =>
                  a && (
                    <a href={href(locale, `${a.category}/${a.slug}`)} data-track="article-next">
                      {a[locale].title} ↗
                    </a>
                  ),
              )}
              <a href={href(locale, 'learn')}>{t('查看全部指南', 'Browse all guides')} ↗</a>
            </nav>
          </article>
          <aside class="article-aside">
            <span>{t('这一页', 'ON THIS PAGE')}</span>
            {outline.map((s) => (
              <a href={`#${s.id}`}>{s.title}</a>
            ))}
            <p>
              {t(
                '从计算到解读，保留每一步的依据。',
                'Keep the basis visible, from calculation to interpretation.',
              )}
            </p>
            <a href={href(locale, 'sources')}>{t('全部参考资料', 'All sources')} ↗</a>
            <a href={href(locale, 'learn')}>{t('回到知识手册', 'Back to the library')} ↗</a>
          </aside>
        </div>
      )}
      {content && (
        <div class="prose-grid">
          <article class="prose">
            {path === 'privacy' && <AnalyticsPreference locale={locale} client:load />}
            {content.sections.map((s, i) => (
              <section id={`section-${i}`}>
                <h2>{s.heading}</h2>
                {s.paragraphs.map((p) => (
                  <p>{p}</p>
                ))}
                {s.bullets && (
                  <ul>
                    {s.bullets.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                )}
              </section>
            ))}
            {path === 'privacy' && (
              <div class="source-list">
                <a href="https://cdn.deepseek.com/policies/en-US/deepseek-privacy-policy.html">
                  {t('AI 服务商隐私政策', 'AI provider privacy policy')} ↗
                </a>
                <a href="https://www.cloudflare.com/privacypolicy/">Cloudflare Privacy Policy ↗</a>
                <a href="https://clarity.microsoft.com/privacy/">Microsoft Clarity Privacy ↗</a>
              </div>
            )}
            {path === 'about' && (
              <a class="button primary" href="https://github.com/wenbu-app/wenbu">
                GitHub ↗
              </a>
            )}
          </article>
          <aside class="article-aside">
            <span>WENBU · {t('公开说明', 'OPEN NOTES')}</span>
            {['about', 'methodology', 'sources', 'free', 'privacy', 'terms']
              .filter((p) => p !== path)
              .map((p) => (
                <a href={href(locale, p)}>{pages[p]?.[locale].title || t('参考资料', 'Sources')}</a>
              ))}
          </aside>
        </div>
      )}
      {path === 'sources' && (
        <div class="prose-grid">
          <article class="prose">
            <h2>{t('我们怎样对待来源', 'How we read a source')}</h2>
            <p>
              {t(
                '以下目录记录本次公开资料研究的范围，核验日期为 2026-09-28。原典用于理解历史符号；算法文档用于检查实现；产品官网用于确认其公开自述；研究用于讨论证据边界。它们不能互相替代。',
                'This directory records the public-source research scope, checked September 28, 2026. Classics inform historical symbolism; technical documents inform implementation; product sites establish public claims; research informs evidence boundaries. Those roles are not interchangeable.',
              )}
            </p>
            <p>
              {t(
                '这不是对全世界所有流派的穷尽研究，也不表示已运行全部第三方项目或购买竞品。未核验的账户内体验、版权范围和预测效果不会被写成已证实事实。',
                'This is not an exhaustive survey of every tradition, nor a claim to have run every project or purchased every competitor. Unverified account features, licensing scope and predictive outcomes are not presented as established facts.',
              )}
            </p>
            {['calculation', 'classics', 'research', 'products', 'agents', 'infrastructure'].map(
              (group, i) => (
                <section>
                  <h2>
                    {t(
                      ['计算与历法', '经典与著作', '研究与证据', '产品参照', 'Skills 与 MCP', '平台与协议'][
                        i
                      ],
                      [
                        'Calculation & calendars',
                        'Classical texts & books',
                        'Research & evidence',
                        'Product references',
                        'Skills & MCP',
                        'Platforms & protocols',
                      ][i],
                    )}
                  </h2>
                  {sources
                    .filter((s) => s.group === group)
                    .map((s) => (
                      <div class="source-list">
                        <a href={s.url} target="_blank" rel="noreferrer">
                          {s.title} ↗
                        </a>
                        <p>{s[locale]}</p>
                      </div>
                    ))}
                </section>
              ),
            )}
          </article>
          <aside class="article-aside">
            <span>{t('可复核的探索', 'TRACEABLE EXPLORATION')}</span>
            <a href={href(locale, 'methodology')}>{t('计算与依据', 'Our methods')}</a>
            <a href={href(locale, 'learn/ai-divination')}>{t('理解 AI 解读', 'Understanding AI readings')}</a>
            <a href="https://github.com/wenbu-app/wenbu/tree/main/docs/research">
              {t('研究记录', 'Research notes')} ↗
            </a>
          </aside>
        </div>
      )}
      {comparison && (
        <div class="prose-grid">
          <article class="prose">
            <h2>{t('先比较使用方式', 'Compare the workflow first')}</h2>
            <p>{comparison[locale].intro}</p>
            <p class="form-note">
              {t(
                `公开资料核验：${comparison.reviewed}。根据官方公开页面比较，未测试登录后或付费体验。`,
                `Public pages checked ${comparison.reviewed}. This comparison uses official sources; paid and signed-in features have not been tested.`,
              )}
            </p>
            <p class="table-scroll-hint">
              {t(
                '左右滑动查看完整对比；使用键盘时，可聚焦表格后按方向键。',
                'Scroll sideways to see the full comparison. With a keyboard, focus the table and use the arrow keys.',
              )}
            </p>
            <div
              class="table-scroll"
              role="region"
              aria-label={t('产品功能对比', 'Product comparison')}
              tabindex="0"
            >
              <table class="comparison-table">
                <thead>
                  <tr>
                    <th>{t('维度', 'Dimension')}</th>
                    <th>Wenbu</th>
                    <th>{t(comparison.nameZh, comparison.nameEn)}</th>
                  </tr>
                </thead>
                <tbody>
                  {comparison[locale].rows.map((row) => (
                    <tr>{row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}</tr>
                  ))}
                </tbody>
              </table>
            </div>
            <h2>{t('怎样选', 'Making a choice')}</h2>
            <p>{comparison[locale].conclusion}</p>
            <div class="source-list">
              {comparison.sources.map((source) => (
                <a href={source.url} target="_blank" rel="noreferrer" data-track="source">
                  {source.title} ↗
                </a>
              ))}
              <a href={href(locale, 'methodology')}>Wenbu · {t('计算方法', 'Methodology')}</a>
              <a href={href(locale, 'free')}>Wenbu · {t('免费使用说明', 'Free-use policy')}</a>
            </div>
            <a class="button primary" href={href(locale, 'learn/choose-a-tool')} data-track="library-start">
              {t('选一个适合的工具', 'Find your starting point')} ↗
            </a>
          </article>
          <aside class="article-aside">
            <span>{t('继续比较', 'KEEP EXPLORING')}</span>
            {comparisons
              .filter((c) => c !== comparison)
              .map((c) => (
                <a href={href(locale, `compare/${c.slug}`)}>{c[locale].title}</a>
              ))}
            <a href={href(locale, 'learn/choose-a-tool')}>{t('怎样选择工具', 'Choose a tool')}</a>
          </aside>
        </div>
      )}
      {path === 'agents' && <Agents locale={locale} />}
    </div>
  )}
</Layout>
