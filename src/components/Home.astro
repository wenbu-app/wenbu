---
import Instrument from './Instrument.astro';
import ArticleCard from './ArticleCard.astro';
import { articles } from '../data/articles';
import { choose, href, toolInfo } from '../lib/i18n';
import type { Locale, ToolKind } from '../lib/schema';
const { locale } = Astro.props as { locale: Locale };
const t = (zh: string, en: string) => choose(locale, zh, en);
const featuredArticles = ['first-reading', 'choose-a-tool', 'tarot-beginner']
  .map((slug) => articles.find((article) => article.slug === slug))
  .filter((article): article is (typeof articles)[number] => Boolean(article));
---

<div class="shell">
  <section class="hero">
    <div class="hero-copy">
      <span class="eyebrow accent">
        <i class="small-dot"></i>
        {t('八字 · 易经 · 塔罗 · 紫微', 'BAZI · I CHING · TAROT · ZI WEI')}
      </span>
      <h1>
        {locale === 'zh' ? (
          <>
            把心里的问题，
            <br />
            <em>看得更清楚。</em>
          </>
        ) : (
          <>
            Bring your question.
            <br />
            <em>See it more clearly.</em>
          </>
        )}
      </h1>
      <p class="hero-description">
        {t(
          '不懂命理也可以开始。把工作、关系或眼前的困惑告诉 Agent，它会帮你理清问题，按需要排盘、抽牌或查资料。也可以直接使用四种免费工具。',
          'You don’t need to know the terminology. Tell Wenbu Agent what’s on your mind, and it can help frame your question, use a tool and look up references. Or explore the four free tools yourself.',
        )}
      </p>
      <div class="hero-buttons">
        <a class="button vermillion" data-track="hero-agent" href={href(locale, 'agent')}>
          {t('带着问题开始对话', 'Start with your question')}
          <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" data-track="hero-chart" href={href(locale, 'bazi')}>
          {t('打开八字排盘', 'Try the BaZi calculator')}
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="hero-meta">
        <span>{t('无需注册', 'NO ACCOUNT')}</span>
        <span>{t('工具免费', 'FREE TOOLS')}</span>
        <span>{t('计算有依据', 'METHODS YOU CAN CHECK')}</span>
      </div>
    </div>
    <div class="hero-visual">
      <Instrument />
      <div class="visual-caption">{t('天地有序 · 万物有时', 'EVERYTHING HAS ITS SEASON')}</div>
    </div>
  </section>
  <a class="home-agent-entry" data-track="home-agent" href={href(locale, 'agent')}>
    <span class="home-agent-mark">问</span>
    <span>
      <small>WENBU AGENT · {t('从提问到看懂结果', 'HELP WITH YOUR FIRST QUESTION')}</small>
      <strong>
        {t('还不知道怎么问？从几个选项开始。', 'Not sure what to ask? Start with a few choices.')}
      </strong>
    </span>
    <span class="home-agent-cta">{t('与命理 Agent 对话', 'Meet Wenbu Agent')} ↗</span>
  </a>
  <div class="almanac-strip">
    <div class="almanac-mark">
      <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width=".8" aria-hidden="true">
        <circle cx="20" cy="20" r="10" />
        <path d="M20 0v6m0 28v6M0 20h6m28 0h6M6 6l5 5m18 18 5 5M6 34l5-5M29 11l5-5" />
      </svg>
      <span>{t('留白一刻', 'A QUIET THOUGHT')}</span>
    </div>
    <p>{t('先从最近的一件具体小事说起。', 'Start with one situation you can describe.')}</p>
    <span class="small-label">{t('问卜 · 日常灵感', 'WENBU · A DAILY PRACTICE')}</span>
  </div>
  <section class="section reveal" id="explore">
    <div class="section-heading">
      <div>
        <span class="eyebrow">{t('四种工具，各有入口', 'FOUR WAYS TO BEGIN')}</span>
        <h2>{t('选择适合当前问题的工具。', 'Choose a way to begin.')}</h2>
      </div>
      <p>
        {t(
          '想看出生时的命盘，选八字或紫微；想梳理一件具体的事，可以从易经或塔罗开始。',
          'BaZi and Zi Wei use your birth details. I Ching and tarot start with a question about your current situation.',
        )}
      </p>
    </div>
    <div class="tool-grid">
      {(Object.keys(toolInfo) as ToolKind[]).map((kind, i) => {
        const tool = toolInfo[kind];
        return (
          <a class={`tool-card ${tool.color}`} href={href(locale, kind)}>
            <div class="tool-card-top">
              <span>
                0{i + 1} / {['BAZI', 'I CHING', 'TAROT', 'ZI WEI'][i]}
              </span>
              <span>↗</span>
            </div>
            <div class="tool-icon" aria-hidden="true">
              {kind === 'bazi' ? (
                <div class="mini-pillar">
                  {['甲\n子', '丙\n寅', '辛\n酉', '壬\n辰'].map((p) => (
                    <span>
                      {p.split('\n')[0]}
                      <br />
                      {p.split('\n')[1]}
                    </span>
                  ))}
                </div>
              ) : kind === 'iching' ? (
                <div class="mini-hex">
                  {[1, 0, 1, 0, 1, 0].map((b) => (
                    <div>
                      {b ? (
                        <i />
                      ) : (
                        <>
                          <i />
                          <i />
                        </>
                      )}
                    </div>
                  ))}
                </div>
              ) : kind === 'tarot' ? (
                <img
                  class="mini-tarot-art"
                  src="/images/tarot/17-star.webp"
                  width="70"
                  height="105"
                  alt=""
                  loading="lazy"
                />
              ) : (
                <div class="mini-star">✳</div>
              )}
            </div>
            <h3>{t(tool.zh, tool.en)}</h3>
            <p>{t(tool.descriptionZh, tool.descriptionEn)}</p>
            <div class="tool-card-bottom">
              <span>
                {t(
                  [
                    '出生日期 · 时间可选',
                    '一个问题 · 六爻成卦',
                    '单张或三张 · 无需生日',
                    '需要出生日期与时辰',
                  ][i],
                  [
                    'BIRTH DATE · TIME OPTIONAL',
                    'ONE QUESTION · SIX LINES',
                    'ONE OR THREE CARDS',
                    'BIRTH DATE AND TIME',
                  ][i],
                )}
              </span>
              <span>↗</span>
            </div>
          </a>
        );
      })}
    </div>
  </section>
  <section class="deck-editorial reveal" aria-labelledby="deck-heading">
    <div class="deck-editorial-art" aria-hidden="true">
      <img src="/images/tarot/02-high-priestess.webp" width="180" height="270" alt="" loading="lazy" />
      <img src="/images/tarot/17-star.webp" width="180" height="270" alt="" loading="lazy" />
      <img src="/images/tarot/19-sun.webp" width="180" height="270" alt="" loading="lazy" />
    </div>
    <div>
      <span class="eyebrow accent">{t('问卜牌组 · 78 张原创插画', 'THE WENBU DECK · 78 ILLUSTRATIONS')}</span>
      <h2 id="deck-heading">{t('先看画面，再读牌义。', 'Take a closer look at the cards.')}</h2>
      <p>
        {t(
          '78 张原创 AI 插画，配有正逆位关键词。可以抽一张整理思绪，也可以用三张牌分别思考当下、牵引与下一步。点开牌面，慢慢看清细节。',
          'Browse 78 original AI illustrations with upright and reversed keywords. Draw one card, or use three to consider your situation, the tension within it and a possible next step. Open any card to see the details.',
        )}
      </p>
      <a class="text-link" data-track="tool-entry" href={href(locale, 'tarot/deck')}>
        {t('翻阅完整 78 张牌', 'Explore all 78 cards')} →
      </a>
    </div>
  </section>
  <div class="home-proof-row">
    <a href={href(locale, 'methodology')}>
      <strong>{t('先看结果，再读解释', 'Check the basis')}</strong>
      <span>
        {t(
          '四柱、星曜、牌面和爻值由工具生成，可查看计算规则与来源。',
          'Inspect the chart or draw, then check the calculation rules and references.',
        )}
      </span>
    </a>
    <a href={href(locale, 'free')}>
      <strong>{t('免费额度公开', 'Clear free allowances')}</strong>
      <span>
        {t(
          '访客试用或账号每日最多 5 次 AI 解读、12 回合对话，登录不重置额度。',
          'Up to five AI readings and 12 Agent turns per guest or account daily. Signing in carries over trial usage.',
        )}
      </span>
    </a>
    <a href={href(locale, 'privacy')}>
      <strong>{t('发送的资料由你选择', 'Know what you’re sharing')}</strong>
      <span>
        {t(
          '免注册即可试用。可选择浏览器留存或登录后云端保存；消息和所选资料交给 AI 处理。',
          'Try without an account. Keep records in this browser or sign in to save them to your account. Messages and selected context are processed by AI.',
        )}
      </span>
    </a>
  </div>
  <section class="manifesto reveal">
    <div>
      <span class="eyebrow accent">{t('看懂来由，保留判断', 'MAKE SENSE OF YOUR READING')}</span>
      <h2>
        {locale === 'zh' ? (
          <>
            看懂结果，
            <br />
            也保留<em>自己的判断。</em>
          </>
        ) : (
          <>
            Understand the reading.
            <br />
            <em>Choose your next step.</em>
          </>
        )}
      </h2>
    </div>
    <div class="manifesto-items">
      {[
        [
          t('核对计算规则', 'Check the method'),
          t(
            '时区、换日方式和随机抽取规则都会影响结果。先确认采用哪套规则，再比较不同工具的结果。',
            'Time zones, day boundaries and draw methods matter. Check the settings before comparing results from different tools.',
          ),
        ],
        [
          t('记下当时的想法', 'Keep a useful record'),
          t(
            '保存结果，补上当时的问题和自己的理解。过些时候再看，哪些贴合，哪些没有。手记可导出备份。',
            'Save the result with your question and notes. Return later to see what held up and what didn’t. Export your journal to keep a backup.',
          ),
        ],
        [
          t('回到现实里验证', 'Test an idea in daily life'),
          t(
            '把有用的启发变成一次沟通、一次查证或一个小尝试。解读提供思路，具体选择还需要现实信息。',
            'Turn an insight into a conversation or a small change you can try. Make decisions with evidence from your actual situation.',
          ),
        ],
      ].map(([title, body], i) => (
        <div class="manifesto-item">
          <span>0{i + 1}</span>
          <div>
            <h3>{title}</h3>
            <p>{body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
  <section class="section reveal">
    <div class="section-heading">
      <div>
        <span class="eyebrow">{t('知识手册 · 从零开始', 'THE WENBU LIBRARY · START HERE')}</span>
        <h2>{t('第一次使用，先读这几篇。', 'A little guidance for your first reading.')}</h2>
      </div>
      <a class="text-link" href={href(locale, 'learn')}>
        {t('翻开知识手册', 'Explore the library')} ↗
      </a>
    </div>
    <div class="article-grid">
      {featuredArticles.map((article) => (
        <ArticleCard article={article} locale={locale} />
      ))}
    </div>
  </section>
  <section class="agent-banner reveal">
    <div>
      <span class="eyebrow">{t('连接你自己的 Agent', 'FOR YOUR OWN AI ASSISTANT')}</span>
      <h2>{t('在熟悉的 Agent 里继续聊。', 'Bring it to your own AI assistant.')}</h2>
      <p>
        {t(
          '通过 MCP、CLI 或 Skill 获取结构化命盘，也可以导出当前结果和自己选择的背景，让已有的对话接着往下走。',
          'Use MCP, the CLI or a Skill to get structured results. You can also export a reading with the context you choose and bring it into an existing conversation.',
        )}
      </p>
      <a class="text-link" href={href(locale, 'agents')}>
        {t('连接我的 Agent', 'Connect your agent')} ↗
      </a>
    </div>
    <div class="agent-terminal">
      <div class="terminal-dots">
        <i />
        <i />
        <i />
      </div>
      <div>
        <span class="prompt">$</span> node wenbu.mjs bazi --file birth.json
      </div>
      <div class="output">{`{ "kind": "bazi",`}</div>
      <div class="output">{`  "pillars": [ … ],`}</div>
      <div class="output">{`  "method": { "engine": "lunar-typescript" } }`}</div>
      <div>
        <span class="prompt">✓</span> {t('依据清楚，上下文由你选择。', 'Clear methods. Context you choose.')}
      </div>
    </div>
  </section>
</div>
